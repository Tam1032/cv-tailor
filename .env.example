# Chỉ cần khi dùng API key (dùng Claude Code với gói claude.ai thì để trống):
# ANTHROPIC_API_KEY=sk-ant-...
# Tuỳ chọn:
# CV_TAILOR_BACKEND=claude-code            # hoặc api; mặc định: api nếu có key, không thì claude-code
# CV_TAILOR_MODEL=claude-opus-5-5          # model mặc định để sửa CV
# CV_TAILOR_EXTRACT_MODEL=claude-haiku-5-5 # model rẻ để tóm tắt JD
# CV_TAILOR_OUTPUT=/duong/dan/luu/ket/qua
# Cho máy khác (cùng mạng Wi-Fi/LAN) truy cập - BẮT BUỘC đặt mật khẩu:
# CV_TAILOR_HOST=0.0.0.0
# CV_TAILOR_PASSWORD=dat-mat-khau-o-day
# CV_TAILOR_PORT=8000
